{
  "doctype": "DocType",
  "name": "ES Customer",
  "module": "EOLA",
  "engine": "InnoDB",
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "field_order": [
    "customer_name",
    "customer_type",
    "email",
    "phone",
    "address",
    "disabled"
  ],
  "fields": [
    {
      "label": "Customer Name",
      "fieldname": "customer_name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "Customer Type",
      "fieldname": "customer_type",
      "fieldtype": "Select",
      "options": "Individual\nCompany",
      "default": "Individual"
    },
    {
      "label": "Email",
      "fieldname": "email",
      "fieldtype": "Data",
      "options": "Email"
    },
    {
      "label": "Phone",
      "fieldname": "phone",
      "fieldtype": "Data"
    },
    {
      "label": "Address",
      "fieldname": "address",
      "fieldtype": "Small Text"
    },
    {
      "label": "Disabled",
      "fieldname": "disabled",
      "fieldtype": "Check"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "share": 1
    },
    {
      "role": "EOLA Technician",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "ES-CUST-.#####",
  "title_field": "customer_name",
  "show_title_field_in_link": 1
}
