      "in_list_view": 1
    },
    {
      "label": "DC Voltage",
      "fieldname": "dc_voltage",
      "fieldtype": "Float",
      "description": "V",
      "in_list_view": 0
    },
    {
      "label": "DC Current",
      "fieldname": "dc_current",
      "fieldtype": "Float",
      "description": "A",
      "in_list_view": 0
    },
    {
      "label": "DC Power",
