{
  "doctype": "DocType",
  "name": "ES Item",
  "module": "EOLA",
  "engine": "InnoDB",
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "field_order": [
    "item_name",
    "item_code",
    "equipment_type",
    "manufacturer",
    "model",
    "description",
    "disabled"
  ],
  "fields": [
    {
      "label": "Item Name",
      "fieldname": "item_name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "label": "Item Code",
      "fieldname": "item_code",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "label": "Equipment Type",
      "fieldname": "equipment_type",
      "fieldtype": "Select",
      "options": "PV Module\nInverter\nBattery\nMeter\nSensor\nOther"
    },
    {
      "label": "Manufacturer",
      "fieldname": "manufacturer",
      "fieldtype": "Data"
    },
    {
      "label": "Model",
      "fieldname": "model",
      "fieldtype": "Data"
    },
    {
      "label": "Description",
      "fieldname": "description",
      "fieldtype": "Text Editor"
    },
    {
      "label": "Disabled",
      "fieldname": "disabled",
      "fieldtype": "Check"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "share": 1
    },
    {
      "role": "EOLA Technician",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "ES-ITEM-.#####",
  "title_field": "item_name",
  "show_title_field_in_link": 1
}
